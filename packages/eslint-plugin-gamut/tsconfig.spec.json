{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    /*
     * @typescript-eslint/rule-tester (and the @typescript-eslint/utils/ts-eslint
     * subpath it depends on) expose their types only via the package "exports"
     * field, which classic ("node") moduleResolution can't read. Use nodenext
     * for the test compile so those subpaths resolve; the package is not
     * "type": "module", so emit stays CommonJS for ts-jest.
     */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "types": ["jest", "node"]
  },
  "include": [
    "jest.config.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.test.tsx",
    "**/*.spec.tsx",
    "**/*.test.js",
    "**/*.spec.js",
    "**/*.test.jsx",
    "**/*.spec.jsx",
    "**/*.d.ts"
  ]
}
