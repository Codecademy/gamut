      "options": { "cwd": "spikes/panda-mf-poc", "command": "yarn cssgen" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "cwd": "spikes/panda-mf-poc", "command": "yarn build" }
    }
  }
}
