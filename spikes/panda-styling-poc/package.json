{
  "name": "gamut-panda-styling-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "codegen": "panda codegen",
    "cssgen": "panda cssgen --outfile src/gamut-static.css",
    "typecheck": "tsc --noEmit",
    "build": "npm run codegen && npm run cssgen && vite build",
    "dev": "vite"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@pandacss/dev": "^0.53.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
