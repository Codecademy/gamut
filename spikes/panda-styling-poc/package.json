{
  "name": "panda-styling-poc",
  "description": "GMT-1715 spike: Panda CSS styling proof of concept (not published)",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "panda codegen",
    "cssgen": "panda cssgen --outfile src/gamut-static.css",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dev": "vite",
    "proof": "esbuild src/proof/parity.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=.proof/parity.cjs --log-level=warning && node .proof/parity.cjs",
    "measure": "esbuild src/proof/measure.ts --bundle --platform=node --format=cjs --outfile=.proof/measure.cjs --log-level=warning && node .proof/measure.cjs",
    "precompute": "esbuild src/precompute/generate.ts --bundle --platform=node --format=cjs --outfile=.proof/generate.cjs --log-level=warning && node .proof/generate.cjs"
  },
  "dependencies": {
    "@codecademy/gamut-styles": "workspace:*",
    "@codecademy/variance": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@pandacss/dev": "^0.53.0",
    "@types/react": "18.3.27",
    "esbuild": "^0.25.0",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "5.9.3",
    "vite": "^5.4.11"
  }
}
